{
  "manifest_version": 3,
  "name": "TabGap",
  "version": "1.0.0",
  "description": "Find the tab you're looking for, instantly.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open TabGap"
  }
}
